# ==============================================================================
# CONTOH KONFIGURASI ENVIRONMENT PRODUKSI (VERCEL + POSTGRESQL EKSTERNAL)
# Salin nilai-nilai ini ke Vercel Dashboard -> Settings -> Environment Variables
# JANGAN cantumkan kredensial rahasia asli ke dalam git repository!
# ==============================================================================

APP_NAME="K3 Compliance"
APP_ENV=production
APP_KEY=base64:GENERATE_DENGAN_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_DEBUG=false
APP_URL=https://nama-project-anda.vercel.app

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Konfigurasi Database PostgreSQL Eksternal (Supabase / Neon / Railway / dsb.)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your_project_id
DB_PASSWORD=your_secure_database_password
DB_SSLMODE=require

# Alternatif: Jika penyedia database menyediakan full connection string
# DB_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ------------------------------------------------------------------------------
# Session, Cache, & Queue (Gunakan database atau redis di environment serverless)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# Email (Opsional)
# ------------------------------------------------------------------------------
MAIL_MAILER=log

